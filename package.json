{
  "name": "omnipath",
  "version": "0.1.0",
  "private": true,
  "description": "A mobile-first 2D open-world action RPG where skills evolve through mastery, morphing, and alchemical fusion.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:single": "node scripts/build-single.mjs"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.4"
  }
}
